    <string name="rs_start_need_title" formatted="false">"开始前的准备"</string>
    <string name="rs_start_need1" formatted="false">"Android 8 或更高版本，以及已签名的 Rookstride APK。"</string>
    <string name="rs_start_need2" formatted="false">"单服务器方案需要一台全新的 Ubuntu 24.04 服务器；双跳方案需要两台不同的、全新的 Ubuntu 24.04 服务器。"</string>
    <string name="rs_start_need3" formatted="false">"服务商提供的地址、SSH 端口、管理员用户名，以及密码或密钥。需要 root 权限或免密码 sudo。"</string>
    <string name="rs_start_need4" formatted="false">"如可获取，请准备服务商控制台中的 SSH 指纹。"</string>
    <string name="rs_start_download" formatted="false">"安装应用"</string>
    <string name="rs_start_download_copy" formatted="false">"下载 APK，验证校验值和签名证书。Android 可能要求允许用于下载文件的应用安装 APK。"</string>
    <string name="rs_start_add" formatted="false">"添加服务器"</string>
    <string name="rs_start_add_copy" formatted="false">"选择“添加网关”或“添加双服务器网关”。准确输入服务商提供的信息，地址、用户名和密码须保持原样。"</string>
    <string name="rs_start_pin" formatted="false">"验证 SSH 指纹"</string>
    <string name="rs_start_pin_copy" formatted="false">"将提供的指纹与服务商控制台中的指纹比较。密钥改变时连接会停止。不要批准无法确认身份的密钥。"</string>
    <string name="rs_start_install" formatted="false">"选择方案并安装"</string>
    <string name="rs_start_install_copy" formatted="false">"在全新 VPS 上创建第一个 VPN 账号，并决定是否保留使用记录。单服务器方案有五个检查点，双服务器方案有八个。"</string>
    <string name="rs_start_wait" formatted="false">"查看进度或继续探索"</string>
    <string name="rs_start_wait_copy" formatted="false">"阅读指南或故事时，安装服务会继续运行。点按进度入口或通知即可返回。时间范围是估算，不是倒计时。"</string>
    <string name="rs_start_resume" formatted="false">"手机停止查询时"</string>
    <string name="rs_start_resume_copy" formatted="false">"独立服务器任务可能仍在运行。重新打开应用，检查并继续已记录的任务。应用被强制停止或 VPS 故障后，不要盲目重新安装。"</string>
    <string name="rs_start_connect" formatted="false">"在此手机上连接"</string>
    <string name="rs_start_connect_copy" formatted="false">"在“用户”中选择 VPN 账号，再选择“在此手机上使用”。输入 VPN 密码，批准 Android 的 VPN 权限，然后连接。VPN 密码不是 root/SSH 密码。"</string>
    <string name="rs_start_check" formatted="false">"检查实际路线"</string>
    <string name="rs_start_check_copy" formatted="false">"分别在 Wi-Fi 和移动网络下检查网站、出口 IPv4、DNS 过滤，以及是否出现意外公网 IPv6。网关提供 IPv4，并有意阻止通过 IPv6 访问互联网。"</string>
    <string name="rs_start_invite" formatted="false">"邀请其他用户"</string>
    <string name="rs_start_invite_copy" formatted="false">"创建账号，导出其 .sswan 配置，并通过可信渠道单独分享 VPN 密码。受邀用户可以使用官方 strongSwan Android 应用。"</string>
    <string name="rs_start_reset_title" formatted="false">"重新开始需要明确操作。"</string>
    <string name="rs_start_reset_copy" formatted="false">"重置会先复核，再删除可识别的网关数据，包括用户、证书、过滤设置和使用记录。Ubuntu、SSH 和软件包程序保留。完整重装操作系统需在服务商面板中进行。"</string>
    <string name="rs_start_reset_phrase" formatted="false">"输入应用显示的准确英文确认短语，例如 DELETE VPN 或 DELETE PAIR。其他客户端将失去访问权限。无法识别的安装会被拒绝重置。"</string>
    <string name="rs_architecture_title" formatted="false">"清晰的路径，自己的服务器。"</string>
    <string name="rs_architecture_intro" formatted="false">"VPN 流量、私有 DNS 和管理连接各有不同职责。"</string>
    <string name="rs_architecture_single" formatted="false">"单服务器"</string>
    <string name="rs_architecture_single_copy" formatted="false">"手机 → IKEv2/IPsec → VPS 上的 strongSwan → IPv4 互联网。AdGuard Home 过滤 DNS，Unbound 在同一 VPS 上解析域名。"</string>
    <string name="rs_architecture_pair" formatted="false">"双服务器"</string>
    <string name="rs_architecture_pair_copy" formatted="false">"手机 → IKEv2/IPsec 入口 → AmneziaWG 3.1 桥接 → 出口 VPS → IPv4 互联网。私有 DNS 过滤在出口运行，路线检查通过后才开启转发。"</string>
    <string name="rs_architecture_admin" formatted="false">"管理"</string>
    <string name="rs_architecture_admin_copy" formatted="false">"应用通过 SSH 与每台服务器通信，并分别固定校验其身份。管理辅助程序仅在 VPS 本地运行，没有公开的 Rookstride 管理 API。"</string>
    <string name="rs_architecture_usage" formatted="false">"连接与使用量"</string>
    <string name="rs_architecture_usage_copy" formatted="false">"可以查看最近观察到的连接、网络端点和大致流量总量。端点无法可靠识别具体设备，统计结果也不能作为计费记录。"</string>
    <string name="rs_architecture_limits" formatted="false">"了解边界"</string>
    <string name="rs_architecture_limits_copy" formatted="false">"VPN 不会隐藏 GPS、账号或 Cookie 信号，不保证网站可访问，也不能改善出口 IP 的信誉。DNS 过滤无法可靠去除 YouTube 视频内广告。"</string>
    <string name="rs_architecture_lockdown" formatted="false">"断开时的保护"</string>
    <string name="rs_architecture_lockdown_copy" formatted="false">"如需在断开时继续保护，请在实际手机上测试 Android 的“始终开启 VPN”和“阻止不通过 VPN 的连接”。这些设置可能影响对新服务器的管理。"</string>
    <string name="rs_routes_title" formatted="false">"选择适合你的路线。"</string>
    <string name="rs_routes_intro" formatted="false">"已实现两种方案，其他协议引擎仍处于研究提案阶段。"</string>
    <string name="rs_routes_single" formatted="false">"单服务器 IKEv2"</string>
    <string name="rs_routes_single_copy" formatted="false">"简洁的起点：在一台全新的 Ubuntu VPS 上运行 strongSwan、AdGuard Home 和 Unbound。"</string>
    <string name="rs_routes_pair" formatted="false">"IKEv2 入口 → AmneziaWG 出口"</string>
    <string name="rs_routes_pair_copy" formatted="false">"两台不同的 Ubuntu 服务器，身份验证、出口 DNS、重置前复核、角色交换和分阶段桥接。手机仍使用内置 strongSwan 引擎。"</string>
    <string name="rs_routes_future" formatted="false">"更多引擎"</string>
    <string name="rs_routes_future_copy" formatted="false">"AmneziaWG/WireGuard 客户端、OpenVPN 和 Xray/VLESS/REALITY 都可能成为后续方案。语言或路线页面有翻译，不代表这些功能已经可用。"</string>
    <string name="rs_routes_network" formatted="false">"选择语言并不保证网络可达。"</string>
    <string name="rs_routes_network_copy" formatted="false">"实际访问取决于客户端网络、服务器服务商和所选协议。请测试自己的 Wi-Fi 与移动网络路径。"</string>
    <string name="rs_download_title" formatted="false">"已签名的应用，对应的源代码。"</string>
    <string name="rs_download_intro" formatted="false">"请使用同一发行版本的文件、校验值和对应源代码。更新时应保持签名证书一致。"</string>
    <string name="rs_download_size" formatted="false">"APK {apk_mib} MiB · 已签名版本代码 {code}"</string>
    <string name="rs_download_source_size" formatted="false">"完整源代码 {source_mib} MiB，包含原创插图及准确匹配的库源代码。"</string>
    <string name="rs_download_verify" formatted="false">"安装前验证"</string>
    <string name="rs_download_hash" formatted="false">"APK SHA-256"</string>
    <string name="rs_download_signer" formatted="false">"签名证书 SHA-256"</string>
    <string name="rs_download_test_title" formatted="false">"查看此发行版本的具体测试"</string>
    <string name="rs_download_test_copy" formatted="false">"发行说明分别列出构建、模拟器测试、模拟朗读事件测试和服务商服务器测试。页面翻译并不会把模拟器通过结果变成实体设备通过结果。"</string>
    <string name="rs_download_voice" formatted="false">"朗读为可选功能。目前故事使用 Android 中已安装的英文离线语音。没有可用语音时，仍可正常阅读。"</string>
    <string name="rs_source_title" formatted="false">"开放的代码，易懂的第一步。"</string>
    <string name="rs_source_intro" formatted="false">"Rookstride 是独立的开源项目，你可以查看、构建和修改。"</string>
    <string name="rs_source_app" formatted="false">"Android 应用与共享方案"</string>
    <string name="rs_source_app_copy" formatted="false">"应用源代码、服务器辅助程序、内置 strongSwan 构建、故事、版权声明和完整对应源代码发行包。"</string>
    <string name="rs_source_single" formatted="false">"单 VPS 网关模板"</string>
    <string name="rs_source_single_copy" formatted="false">"通过命令行在全新 Ubuntu 服务器上部署 strongSwan、AdGuard Home 和 Unbound。"</string>
    <string name="rs_source_pair" formatted="false">"Two-Hop VPN Gateway"</string>
    <string name="rs_source_pair_copy" formatted="false">"独立的 IKEv2 → AmneziaWG 服务器模板，附有路由与恢复设计文档。"</string>
    <string name="rs_source_license" formatted="false">"许可证清晰可见"</string>
    <string name="rs_source_license_copy" formatted="false">"组合应用与原创 Rook 素材使用 GPL-3.0-or-later；网关脚本保留 MIT 许可。上游项目保留其声明和名称，不代表获得这些厂商的认可。"</string>
    <string name="rs_source_privacy" formatted="false">"保护私密信息"</string>
    <string name="rs_source_privacy_copy" formatted="false">"不要将真实服务器地址、管理员密码、密钥、导出文件或私密日志放入公开问题或源代码。公开网站不收集 SSH 凭据。"</string>
    <string name="rs_source_translate" formatted="false">"协助翻译"</string>
    <string name="rs_source_translate_copy" formatted="false">"共享文本目录会跟踪原文变更、必需占位符和审核状态。模型审核、屏幕检查与社区母语贡献者的审核分别记录。"</string>
    <string name="rs_rook_title" formatted="false">"认识 Rook，你的旅途向导。"</string>
    <string name="rs_rook_intro" formatted="false">"一只小红鸟、一盏黄铜灯，总是先倾听，再伸出援手。"</string>
    <string name="rs_rook_origin_title" formatted="false">"从地图册走来的旅人"</string>
    <string name="rs_rook_origin" formatted="false">"Lumen 在一本旧地图册中未完成的路线旁发现了 Rook。暴风雨时，一点灯油滴到了书页边缘。Rook 眨眨眼，走到图书馆的桌上，帮助一位受困的信使重新出发。Lumen 给了他名字、围巾和挎包；如何使用它们，由 Rook 自己决定。"</string>
    <string name="rs_rook_rule" formatted="false">"好的路线，会为下一位旅人留下选择。"</string>
    <string name="rs_rook_roles" formatted="false">"熟悉的面孔，不同的帮助"</string>
    <string name="rs_rook_guide" formatted="false">"主人与向导"</string>
    <string name="rs_rook_guide_copy" formatted="false">"欢迎你，并解释下一步。"</string>
    <string name="rs_rook_map" formatted="false">"领航员"</string>
    <string name="rs_rook_map_copy" formatted="false">"比较路径，也坦承何时还需再检查。"</string>
    <string name="rs_rook_builder" formatted="false">"建造者"</string>
    <string name="rs_rook_builder_copy" formatted="false">"标示安装阶段；准确状态仍由实际进度界面提供。"</string>
    <string name="rs_rook_lantern" formatted="false">"同伴"</string>
    <string name="rs_rook_lantern_copy" formatted="false">"分享灯光与书本，也留出自主选择的空间。"</string>
    <string name="rs_rook_wait" formatted="false">"耐心的助手"</string>
    <string name="rs_rook_wait_copy" formatted="false">"说明等待原因，不编造完成百分比或结束时间。"</string>
    <string name="rs_rook_celebrate" formatted="false">"庆祝伙伴"</string>
    <string name="rs_rook_celebrate_copy" formatted="false">"为已完成且通过验证的里程碑庆祝。"</string>
    <string name="rs_rook_fiction" formatted="false">"故事属于虚构，与技术或隐私保证分开。角色、姿态和插图均为 Rookstride 原创作品。"</string>
    <string name="rs_worlds_title" formatted="false">"一只小鸟，更广阔的世界。"</string>
    <string name="rs_worlds_intro" formatted="false">"五个相连的虚构世界，每个世界十章，共两百页插图。可以逐页阅读、看完整章，或按自己的节奏聆听。"</string>
    <string name="rs_worlds_english" formatted="false">"故事目前使用英文书写和朗读。主要导航和安装已翻译；故事翻译将作为后续独立审核任务。"</string>
    <string name="rs_worlds_open" formatted="false">"打开英文故事"</string>
    <string name="rs_worlds_harbor" formatted="false">"灯笼港"</string>
    <string name="rs_worlds_harbor_copy" formatted="false">"共同的起点：借来的灯光、经过检查的桥梁、隐私，以及一本为选择留出空间的书。"</string>
    <string name="rs_worlds_persia" formatted="false">"众门之园"</string>
    <string name="rs_worlds_persia_copy" formatted="false">"一段虚构旅程，灵感来自选取的伊朗与波斯园林、书籍、工艺和共享路线。"</string>
    <string name="rs_worlds_china" formatted="false">"归灯之河"</string>
    <string name="rs_worlds_china_copy" formatted="false">"一段虚构旅程，取材于中国的河流、工艺、印刷和城市园林传统。"</string>
    <string name="rs_worlds_russia" formatted="false">"雪中图书馆"</string>
    <string name="rs_worlds_russia_copy" formatted="false">"一个虚构的冬日社区，借来的靴子、朴素的护耳帽，以及学着倾听的会说话面包。"</string>
    <string name="rs_worlds_america" formatted="false">"广阔天空下的公共天地"</string>
    <string name="rs_worlds_america_copy" formatted="false">"一个虚构的美国社区，讲述档案、无障碍通道、公民承诺和多种声音。"</string>
    <string name="rs_worlds_culture" formatted="false">"这些是虚构的地方，并不代表某个国家的所有人。文化说明与原始来源仍可用英文查看。"</string>
    <string name="rs_plans_title" formatted="false">"实用的第一款应用，审慎开启下一章。"</string>
    <string name="rs_plans_intro" formatted="false">"Android 目前已可使用。浏览器、iPhone 和聊天工具需要各自实现和测试。这些计划不代表已经有可下载产品。"</string>
    <string name="rs_plans_languages" formatted="false">"先做好多语言"</string>
    <string name="rs_plans_languages_copy" formatted="false">"英文、俄文、波斯文、阿拉伯文和简体中文覆盖首批实用流程。灵活布局、从右向左显示与共享目录，让后续更新可审核。"</string>
    <string name="rs_plans_browser" formatted="false">"浏览器规划与原生应用衔接"</string>
    <string name="rs_plans_browser_copy" formatted="false">"先帮助用户选择方案，再打开原生安装程序，不在计划中放入密码。普通浏览器和 PWA 无法建立原始 SSH 连接。"</string>
    <string name="rs_plans_controller" formatted="false">"用户控制的网页管理"</string>
    <string name="rs_plans_controller_copy" formatted="false">"后续可通过本地辅助程序或自托管连接器实现浏览器管理。需要经过身份验证的 HTTPS、SSH 身份检查、受限操作、能持久保存并恢复的任务，以及私密凭据边界。"</string>
    <string name="rs_plans_iphone" formatted="false">"iPhone 管理与 VPN"</string>
    <string name="rs_plans_iphone_copy" formatted="false">"研究原生 SSH、Keychain 存储、Apple VPN 权限和应用审核要求。可复用方案契约，但 Android VPN 引擎不会自动成为 iPhone 引擎。"</string>
    <string name="rs_plans_telegram" formatted="false">"Telegram 助手"</string>
    <string name="rs_plans_telegram_copy" formatted="false">"未来的机器人或 Mini App 可以引导入门，并显示获准查看的状态。需验证会话，且变更必须明确批准。root 密码和私钥不得发送到聊天中。"</string>
    <string name="rs_plans_wechat" formatted="false">"微信 / WeChat"</string>
    <string name="rs_plans_wechat_copy" formatted="false">"承诺支持前，先评估实际平台 API、域名规则、账号资格和审核要求。状态助手、VPN 客户端与 SSH 安装工具需分别验证。"</string>
    <string name="rs_plans_gates" formatted="false">"每个平台都需要自己的验证。"</string>
    <string name="rs_plans_gates_copy" formatted="false">"发送凭据前验证服务器身份，明确选择协议，保留重置前复核和故障时阻断转发，并测试中断、恢复及实际设备。"</string>
    <string name="rs_plans_research" formatted="false">"阅读详细英文研究与待办计划"</string>
