[Unit]
Description=Rookstride private website and editorial pilot
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=rookstride-web
Group=rookstride-web
WorkingDirectory=/opt/rookstride-web/current
StateDirectory=rookstride-web
StateDirectoryMode=0700
Environment=ROOKSTRIDE_DATA_DIR=/var/lib/rookstride-web
Environment=NODE_OPTIONS=--max-old-space-size=1536
ExecStart=/usr/local/bin/node /opt/rookstride-web/current/deploy/serve.mjs private
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
